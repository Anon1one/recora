{
  "name": "recora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @recora/web dev",
    "build:web": "pnpm --filter @recora/web build",
    "test:web": "pnpm --filter @recora/web test",
    "typecheck:web": "pnpm --filter @recora/web typecheck",
    "build": "anchor build --arch v0",
    "codegen": "codama run client",
    "test": "cd programs/recora && cargo test --locked",
    "keeper": "ts-node scripts/keeper.ts",
    "test:ts": "ts-mocha -p ./tsconfig.json -t 1000000 'tests/**/*.spec.ts'",
    "test:keeper": "ts-node tests/keeper.smoke.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:devnet": "ts-mocha -p ./tsconfig.json -t 1000000 tests/happy-path.devnet.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@anchor-lang/spl-token": "^1.0.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "chai": "^4.4.1",
    "codama": "^1.11.0",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
