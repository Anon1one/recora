# Use a Neon development branch even when Next.js runs locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/recora?sslmode=require
APP_ORIGIN=http://localhost:3000
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
RECORA_PROGRAM_ID=ByzDYmPuV1FK7Z4RMGLgnqELFLZf3u2GoRSsB9bTndiu
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
# Optional public HTTPS receiver URL when APP_ORIGIN is a local browser URL.
HELIUS_CALLBACK_URL=
JOB_SECRET=
# Optional batch caps (1–1000); separate time budgets also bound each job run.
INDEXER_BATCH_LIMIT=100
WEBHOOK_BATCH_LIMIT=100
# 64 hex characters (32 random bytes), encrypts merchant webhook secrets.
WEBHOOK_ENCRYPTION_KEY=
# Optional separate Neon test branch. ALLOW_SHARED_TEST_DATABASE=1 permits
# DATABASE_URL instead; tests isolate all tables and foreign keys in a temporary schema.
TEST_DATABASE_URL=
